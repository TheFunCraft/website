# Copy these into Vercel > Project > Settings > Environment Variables (do NOT commit real values).

# The admin password for /login. Use a long, random value.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Secret used to sign the admin session cookie. Any long random string.
# Optional: if left unset, the cookie is signed with ADMIN_PASSWORD instead.
SESSION_SECRET=another-long-random-string

# Postgres connection. When you add Vercel Postgres or connect Neon through the
# Vercel integration, POSTGRES_URL is set for you automatically — you usually
# don't need to set this by hand.
# POSTGRES_URL=postgres://user:password@host/db?sslmode=require
